
abs_rtl_dir  := absolute_path("../generated/")
abs_cva6_dir := absolute_path("../submodules/cva6")
abs_ibex_dir := absolute_path("../submodules/ibex")

genus-flist:
    @echo "Generating Genus Filelist with absolute paths..."
    SCHNITZEL_RTL_DIR="{{ abs_rtl_dir }}" \
    CVA6_PATH="{{ abs_cva6_dir }}" \
    IBEX_PATH="{{ abs_ibex_dir }}" \
    bender script genus > flist.tcl

copy_template := absolute_path("./copy.sh.tera")

# Generating scripts for the asic flow consists of two things:
# (1) Copying over the flist.tcl generated by genus-flist, the ROOT directory should be replaced manually
# (2) Copy over all the files, this is supported by the copy-flist rule which generates a collection of all 
#     source files which can be used with rsync to copy over to the synthesis server

copy-flist:
    @echo "Generating Copy Script"
    SCHNITZEL_RTL_DIR="{{ abs_rtl_dir }}" \
    CVA6_PATH="{{ abs_cva6_dir }}" \
    IBEX_PATH="{{ abs_ibex_dir }}" \
    bender script template --template {{copy_template}} > copy.sh

copy-server ssh-target:
    rsync -avz --relative --files-from=syn/copy.sh .. {{ssh-target}}
